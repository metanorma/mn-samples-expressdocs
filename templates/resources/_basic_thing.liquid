
{% render "templates/resources/basic_title", thing_prefix: thing_prefix, anchor: thing.id, title: thing.id, depth: depth %}

{% if thing.remarks %}
{% assign remarks_text = thing.remarks | join: " " | strip %}
{% if remarks_text != blank %}
{% for thing_remark in thing.remarks %}
{% if thing_remark != null and thing_remark != "" -%}{{ thing_remark }}{%- endif %}
{% endfor %}
{% else %}
{% comment %}
Blank remarks array: fall through to the generated boilerplate (SC4UTILITI-112).
These boilerplates only apply to TYPE and SUBTYPE CONSTRAINT definitions.
{% endcomment %}
{% render "templates/resources/boilerplates", definition: thing, object_type: object_type %}
{% endif %}
{% else %}
{% comment %}
These boilerplates only apply to TYPE and SUBTYPE CONSTRAINT definitions
{% endcomment %}
{% render "templates/resources/boilerplates", definition: thing, object_type: object_type %}
{% endif %}

{% render "templates/common_files/body_remarks", remark_items: thing.remark_items %}

{% render "templates/common_files/source_code", source: thing.source %}
